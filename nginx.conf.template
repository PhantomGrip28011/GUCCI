worker_processes 1;
pid /run/nginx.pid;
error_log /dev/stderr warn;

events {
    worker_connections 1024;
}

http {
    access_log off;
    client_max_body_size 64m;

    server {
        # Bind only the container's primary IP (NOT 0.0.0.0) — the internal
        # xray API socket lives on 127.0.0.1:62789 and wildcard binds collide.
        listen ${LISTEN_ADDR}:${FIXED_PORT};

        # --------------------------------------------
        # Subscription service (sub links)
        # -> internal 3x-ui sub server on loopback:2096
        # --------------------------------------------
        location /sub/ {
            proxy_pass http://127.0.0.1:2096;
            proxy_http_version 1.1;
            proxy_set_header Host $host;
            proxy_set_header X-Forwarded-Host $host;
            proxy_set_header X-Forwarded-Proto $scheme;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        }

        # JSON subscription (used only if Sub-Json is enabled in panel settings)
        location /json/ {
            proxy_pass http://127.0.0.1:2096;
            proxy_http_version 1.1;
            proxy_set_header Host $host;
            proxy_set_header X-Forwarded-Host $host;
            proxy_set_header X-Forwarded-Proto $scheme;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        }

# Optional: user inbound that was relocated off the public port
        ${EXTRA_LOCATION}

        # Static, always-correct subscription feed (panel modal links are
        # right; the built-in /sub/ shows stale origin-node data on
        # node-linked inbounds — this endpoint always advertises the
        # working railway proxy endpoint).
        ${SUBFIX_LOCATION}

        # --------------------------------------------
        # Foolproof short sub link: /<subId> works too
        # (in case the /sub/ prefix gets dropped when
        # the link is typed or shared by hand)
        # --------------------------------------------
        location ~ "^/(?<guccisid>[a-z0-9]{16})/?$" {
            proxy_pass http://127.0.0.1:2096/sub/$guccisid;
            proxy_http_version 1.1;
            proxy_set_header Host $host;
            proxy_set_header X-Forwarded-Host $host;
            proxy_set_header X-Forwarded-Proto $scheme;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        }

        # --------------------------------------------
        # Web panel
        # -> internal 3x-ui panel on loopback:12053
        # --------------------------------------------
        location / {
            proxy_pass http://127.0.0.1:12053;
            proxy_http_version 1.1;
            proxy_set_header Upgrade $http_upgrade;
            proxy_set_header Connection "upgrade";
            proxy_set_header Host $host;
            proxy_set_header X-Forwarded-Host $host;
            proxy_set_header X-Forwarded-Proto $scheme;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        }
    }
}
