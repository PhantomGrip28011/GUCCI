worker_processes 1;
pid /run/nginx.pid;
error_log /dev/stderr warn;

events {
    worker_connections 1024;
}

http {
    access_log off;
    client_max_body_size 64m;

    server {
        # Bind only the container's primary IP (NOT 0.0.0.0) — the internal
        # xray API socket lives on 127.0.0.1:62789 and wildcard binds collide.
        listen ${LISTEN_ADDR}:${FIXED_PORT};

        # --------------------------------------------
        # Subscription service  ->  <domain>/sub/<id>
        # --------------------------------------------
        location /sub/ {
            # 2097 = subshim (renames/reorders links + live usage card),
            # which itself proxies the real panel sub service on 2096.
            proxy_pass http://127.0.0.1:2097;
            proxy_http_version 1.1;
            proxy_set_header Host $host;
            proxy_set_header X-Forwarded-Host $host;
            proxy_set_header X-Forwarded-Proto $scheme;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        }

        # JSON subscription (only if Sub-Json is enabled)
        location /json/ {
            proxy_pass http://127.0.0.1:2096;
            proxy_http_version 1.1;
            proxy_set_header Host $host;
            proxy_set_header X-Forwarded-Host $host;
            proxy_set_header X-Forwarded-Proto $scheme;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        }

        # Optional: user inbound relocated off the public port
        ${EXTRA_LOCATION}

        # Static, always-correct subscription feed at /subfix/gucci
        ${SUBFIX_LOCATION}

        # Short sub link: /aaaaaaaaaaaaaaaa also serves the sub
        location ~ "^/(?<guccisid>[a-z0-9]{16})/?$" {
            proxy_pass http://127.0.0.1:2097/sub/$guccisid;
            proxy_http_version 1.1;
            proxy_set_header Host $host;
            proxy_set_header X-Forwarded-Host $host;
            proxy_set_header X-Forwarded-Proto $scheme;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        }

        # --------------------------------------------
        # HIDDEN web panel — ONLY reachable at /gucciBMW/
        # (secret path; no one can discover the panel)
        # --------------------------------------------
        location /gucciBMW/ {
            proxy_pass http://127.0.0.1:12053;
            proxy_http_version 1.1;
            proxy_set_header Upgrade $http_upgrade;
            proxy_set_header Connection "upgrade";
            proxy_set_header Host $host;
            proxy_set_header X-Forwarded-Host $host;
            proxy_set_header X-Forwarded-Proto $scheme;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        }
        location = /gucciBMW {
            proxy_pass http://127.0.0.1:12053;
            proxy_http_version 1.1;
            proxy_set_header Host $host;
        }

        # --------------------------------------------
        # EVERYTHING ELSE -> plain BLACK page (HTTP 200)
        # Root / and any unknown path shows nothing but black,
        # never a railway error page, never the panel.
        # --------------------------------------------
        location / {
            default_type text/html;
            return 200 "${BLACK_BODY}";
        }
    }
}
